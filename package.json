{
    "name": "fp-reimbursement-system",
    "private": false,
    "version": "4.1.1",
    "type": "module",
    "description": "FP 报销信息整理识别系统 - 中国式增值税发票 + 订单截图 OCR 自动识别报销系统",
    "author": "yourproject",
    "license": "MIT",
    "homepage": "https://github.com/<YOUR_GITHUB_USERNAME>/fp-reimbursement-system",
    "repository": {
        "type": "git",
        "url": "https://github.com/<YOUR_GITHUB_USERNAME>/fp-reimbursement-system.git"
    },
    "bugs": {
        "url": "https://github.com/<YOUR_GITHUB_USERNAME>/fp-reimbursement-system/issues"
    },
    "keywords": [
        "invoice-ocr",
        "reimbursement",
        "paddleocr",
        "react",
        "express",
        "prisma",
        "vite"
    ],
    "scripts": {
        "client:dev": "vite",
        "build": "npm run check && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "check": "tsc --noEmit",
        "server:dev": "nodemon",
        "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
        "start": "tsx api/server.ts",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "test": "vitest run",
        "postinstall": "prisma generate",
        "setup:fonts": "node scripts/download-fonts.js"
    },
    "dependencies": {
        "@pdf-lib/fontkit": "^1.1.1",
        "@prisma/client": "^6.11.1",
        "bcryptjs": "^3.0.2",
        "clsx": "^2.1.1",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "express-session": "^1.18.1",
        "lucide-react": "^0.511.0",
        "multer": "^2.0.2",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^4.10.38",
        "pdfkit": "^0.15.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.3.0",
        "subset-font": "^2.5.0",
        "tailwind-merge": "^3.0.2",
        "tesseract.js": "^7.0.0",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.2",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.15.30",
        "@types/pdfkit": "^0.13.4",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/supertest": "^6.0.3",
        "@vercel/node": "^5.3.6",
        "@vitejs/plugin-react": "^4.4.1",
        "autoprefixer": "^10.4.21",
        "babel-plugin-react-dev-locator": "^1.0.0",
        "concurrently": "^9.2.0",
        "eslint": "^9.25.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "nodemon": "^3.1.10",
        "postcss": "^8.5.3",
        "prisma": "^6.11.1",
        "supertest": "^7.1.1",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.20.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.4.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    }
}
