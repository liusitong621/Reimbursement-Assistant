DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-your-session-secret"
PORT=3001

# 3.2 新增：发票识别服务地址
# 本地开发（OCR 服务跑在 127.0.0.1:8001）：保持默认即可
# OCR_SERVICE_URL=http://127.0.0.1:8001
# 正式版 3.2（OCR 服务跑在新加坡/上海服务器，对内 HTTP）：
# OCR_SERVICE_URL=http://<SHANGHAI_SERVER_IP>:8001
# 正式版 3.2（走 Cloudflare + Caddy HTTPS，对外域名）：
OCR_SERVICE_URL=https://fp-api.example.com
# 单张发票 OCR 超时（毫秒），PDF 大图默认 90s 足够
OCR_TIMEOUT_MS=90000
